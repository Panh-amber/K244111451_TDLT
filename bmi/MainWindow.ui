  <property name="styleSheet">
   <string notr="true">
/* ===== Global Window ===== */
QMainWindow {
    background-color: #f0f2f5;
}

/* ===== Central Card ===== */
#centralwidget {
    background-color: #f0f2f5;
}

/* ===== Header Label ===== */
#label {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #667eea, stop:1 #764ba2);
    color: #ffffff;
    border-radius: 12px;
    padding: 8px;
    font-weight: bold;
    letter-spacing: 1px;
}

/* ===== Form Labels ===== */
#label_2, #label_3, #label_4, #label_5, #label_6, #label_7, #label_10 {
    color: #4a4a68;
    font-weight: 600;
}

/* ===== Input Fields ===== */
QLineEdit {
    background-color: #ffffff;
    border: 2px solid #d1d5db;
    border-radius: 8px;
    padding: 6px 12px;
    color: #1f2937;
    selection-background-color: #667eea;
}
QLineEdit:focus {
    border: 2px solid #667eea;
}

/* ===== Result Card (BMI value) ===== */
#labelBMI {
    background-color: #eef2ff;
    border: 2px solid #667eea;
    border-radius: 8px;
    padding: 4px 12px;
    color: #4338ca;
    font-weight: bold;
}

/* ===== Comment Card ===== */
#labelComment {
    background-color: #fef2f2;
    border: 2px solid #f87171;
    border-radius: 8px;
    padding: 4px 12px;
    color: #dc2626;
    font-weight: bold;
}

/* ===== Calculate Button ===== */
#pushButtonCalculate {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #667eea, stop:1 #764ba2);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px 24px;
    font-weight: bold;
    font-size: 13pt;
}
#pushButtonCalculate:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #5a6fd6, stop:1 #6a4194);
}
#pushButtonCalculate:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4f5fc2, stop:1 #5e3986);
}

/* ===== Close Button ===== */
#pushButtonClose {
    background-color: #ffffff;
    color: #6b7280;
    border: 2px solid #d1d5db;
    border-radius: 10px;
    padding: 10px 24px;
    font-weight: bold;
    font-size: 13pt;
}
#pushButtonClose:hover {
    background-color: #f9fafb;
    border-color: #9ca3af;
    color: #374151;
}
#pushButtonClose:pressed {
    background-color: #f3f4f6;
}

/* ===== Status Bar ===== */
QStatusBar {
    background-color: #e5e7eb;
    color: #6b7280;
    font-size: 9pt;
}
   </string>
